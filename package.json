{
  "name": "the-beauty-shop-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build --config client/vite.config.ts && node scripts/check-public-build.mjs",
    "preview": "vite preview --config client/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "7.3.6"
  }
}
